<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#121212"
    android:padding="24dp">

    <!-- Tiêu đề lớn -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AUTO CALLOG"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.05"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đăng nhập bằng API Key"
        android:textSize="14sp"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="24dp"/>

    <!-- Khung card đen bo tròn bên trong -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_license"
        android:padding="20dp"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API Key"
            android:textSize="14sp"
            android:textColor="#DDDDDD"
            android:layout_marginBottom="8dp"/>

        <!-- Ô nhập Key (Giữ nguyên ID là etKey để khớp với code Java cũ của bạn) -->
        <EditText
            android:id="@+id/etKey"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Nhập API key của bạn"
            android:textColorHint="#777777"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/bg_edit_text"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:layout_marginBottom="20dp"/>

        <!-- Nút Đăng Nhập phong cách Launch Now -->
        <Button
            android:id="@+id/btnCheckKey"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="ĐĂNG NHẬP"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:letterSpacing="0.05"
            android:background="@drawable/bg_btn_launch"
            android:layout_marginBottom="12dp"
            style="?android:attr/borderlessButtonStyle"/>

        <!-- Nút Mua API Key phong cách Hồng Neon -->
        <Button
            android:id="@+id/btnBuyKey"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="MUA API KEY"
            android:textColor="#FF80AB"
            android:textStyle="bold"
            android:textSize="15sp"
            android:letterSpacing="0.05"
            android:background="@drawable/bg_btn_neon_pink"
            style="?android:attr/borderlessButtonStyle"/>

    </LinearLayout>

    <!-- Tên tác giả ở dưới cùng -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Được phát triển bởi N.T.SON"
        android:textSize="13sp"
        android:textColor="#777777"/>

</LinearLayout>
