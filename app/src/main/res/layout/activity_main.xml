<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F5F5F5">

    

    <!-- Nút cấp quyền -->
    <Button
        android:id="@+id/btnGrantPermissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cấp quyền ứng dụng &amp; Mặc định"
        android:backgroundTint="#00796B"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp"/>

    <!-- Nút mở cài đặt ứng dụng mặc định -->
    <Button
        android:id="@+id/btnOpenDefaultSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mở Cài đặt Ứng dụng Mặc định"
        android:backgroundTint="#00796B"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp"/>

    

    <!-- Nút mở cài đặt trợ năng -->
    <Button
        android:id="@+id/btnOpenAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mở Cài đặt Trợ năng (Accessibility)"
        android:backgroundTint="#1976D2"
        android:textColor="#FFFFFF"/>

    <!-- Nút mở bảng điều khiển popup nổi -->
    <Button
        android:id="@+id/btnStartPopup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bật Bảng Điều Khiển Auto"
        android:backgroundTint="#D32F2F"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp"/>

    </LinearLayout>

    <!-- THẺ NÀY ĐÓNG VAI TRÒ ĐẨY KHOẢNG TRỐNG, GIÚP HSD RƠI XUỐNG DƯỚI CÙNG -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- HIỂN THỊ HẠN SỬ DỤNG (Nằm góc dưới cùng bên trái, chữ nghiêng) -->
    <TextView
        android:id="@+id/txtExpiry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HSD: 30/09/2026"
        android:textSize="14sp"
        android:textStyle="italic"
        android:textColor="#555555"
        android:gravity="start"
        android:layout_marginBottom="8dp"/>

</LinearLayout>
