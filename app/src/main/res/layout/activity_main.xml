<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- 1. NÚT CẤP QUYỀN (Màu Xanh) -->
    <Button
        android:id="@+id/btnGrantPermissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#4CAF50"
        android:text="CẤP TẤT CẢ QUYỀN &amp; MẶC ĐỊNH"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- 2. NÚT MỞ CÀI ĐẶT MẶC ĐỊNH (Màu Xanh) -->
    <Button
        android:id="@+id/btnOpenDefaultSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#4CAF50"
        android:text="MỞ CÀI ĐẶT ỨNG DỤNG MẶC ĐỊNH"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- 3. NÚT TRỢ NĂNG (Màu Xanh) -->
    <Button
        android:id="@+id/btnOpenAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#4CAF50"
        android:text="BẬT QUYỀN TRỢ NĂNG (ACCESSIBILITY)"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- 4. NÚT MỞ BẢNG ĐIỀU KHIỂN AUTO (Đã chuyển xuống cuối cùng và đổi sang Màu Cam) -->
    <Button
        android:id="@+id/btnStartPopup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#FF9800"
        android:text="MỞ BẢNG ĐIỀU KHIỂN AUTO"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

</LinearLayout>
