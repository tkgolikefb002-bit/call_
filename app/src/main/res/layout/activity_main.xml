<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <Button
        android:id="@+id/btnGrantPermissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="15dp"
        android:text="Cấp Tất Cả Quyền &amp; Mặc Định"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnOpenDefaultSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="15dp"
        android:text="Mở Cài Đặt Ứng Dụng Mặc Định"
        android:textSize="16sp" />

    <!-- NÚT BẬT POPUP NỔI AUTO -->
    <Button
        android:id="@+id/btnStartPopup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#4CAF50"
        android:padding="15dp"
        android:text="Mở Bảng Điều Khiển Auto"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

     <!-- Nút khôi phục / reset quyền nhanh -->
<Button
    android:id="@+id/btnResetRole"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Khôi phục / Reset Quyền Mặc Định"
    android:layout_marginTop="10dp"/>

<!-- Nút hướng dẫn / lấy lệnh ADB nhanh -->
<Button
    android:id="@+id/btnShowAdbCommand"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Lấy lệnh ADB gán quyền nhanh"
    android:layout_marginTop="10dp"/>
</LinearLayout>
