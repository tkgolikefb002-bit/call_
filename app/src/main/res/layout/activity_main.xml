<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- Hiển thị hạn sử dụng bản quyền -->
    <TextView
        android:id="@+id/txtExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hạn sử dụng đến ngày: Đang cập nhật..."
        android:textSize="16sp"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <!-- Nút cấp quyền -->
    <Button
        android:id="@+id/btnGrantPermissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cấp quyền ứng dụng &amp; Mặc định"
        android:layout_marginBottom="12dp"/>

    <!-- Nút mở cài đặt ứng dụng mặc định -->
    <Button
        android:id="@+id/btnOpenDefaultSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mở Cài đặt Ứng dụng Mặc định"
        android:layout_marginBottom="12dp"/>

    <!-- Nút mở bảng điều khiển popup nổi -->
    <Button
        android:id="@+id/btnStartPopup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bật Popup Điều Khiển Auto"
        android:layout_marginBottom="12dp"/>

    <!-- Nút mở cài đặt trợ năng -->
    <Button
        android:id="@+id/btnOpenAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mở Cài đặt Trợ năng (Accessibility)"/>

</LinearLayout>
