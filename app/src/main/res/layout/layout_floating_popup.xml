<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_box"
    android:orientation="vertical"
    android:padding="12dp"
    android:elevation="8dp">

    <!-- Tiêu đề & Nút chức năng phía trên -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tiến độ: 0/0 đơn"
            android:textColor="#00FF66"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="10dp"
            android:src="@android:ic_menu_manage" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@android:ic_menu_close_clear_cancel" />
    </LinearLayout>

    <!-- Hàng 3 nút bấm chính -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Nút Tìm kiếm (Cam) -->
        <Button
            android:id="@+id/btnSearch"
            android:layout_width="50dp"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#FF9800"
            android:text="🔍"
            android:textSize="16sp" />

        <!-- Nút Chạy / Dừng (Xanh dương - Tự động đổi icon) -->
        <Button
            android:id="@+id/btnPlayPause"
            android:layout_width="50dp"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#2196F3"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Nút Xóa / Thùng rác (Đỏ) -->
        <Button
            android:id="@+id/btnDelete"
            android:layout_width="50dp"
            android:layout_height="42dp"
            android:backgroundTint="#F44336"
            android:text="🗑"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>
